{
  "name": "aem-contact-sheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "test": "node --test packages/core/__tests__/*.test.js actions/__tests__/*.test.js",
    "test:all": "node --test packages/core/__tests__/*.test.js actions/__tests__/*.test.js internal/__tests__/*.test.js",
    "build:exchange": "rm -rf .parcel-cache dist && CONTACTSHEET_INTERNAL_FEATURES=false npx aio app build && node scripts/check-exchange.js",
    "check:exchange": "node scripts/check-exchange.js",
    "deploy:exchange": "node scripts/deploy-exchange.js prod",
    "deploy:exchange:stage": "node scripts/deploy-exchange.js stage",
    "build:demo": "node scripts/with-demo-config.js build",
    "deploy:demo": "node scripts/with-demo-config.js deploy",
    "demo": "node scripts/build-demo.js"
  },
  "dependencies": {
    "@adobe/aio-sdk": "^6",
    "@adobe/uix-guest": "^0.10.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "openwhisk": "^3.21.8",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  }
}
